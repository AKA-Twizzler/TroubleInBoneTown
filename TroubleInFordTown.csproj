<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MurderLab</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net6.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <PropertyGroup Condition="'$(BONELAB_DIR)' == ''">
    <BONELAB_DIR>/mnt/d/SteamLibrary/steamapps/common/BONELAB</BONELAB_DIR>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="TroubleInFordTown.Resources.brainwash_charge.wav" />
    <None Remove="TroubleInFordTown.Resources.innocents_line1.wav" />
    <None Remove="TroubleInFordTown.Resources.innocents_line2.wav" />
    <None Remove="TroubleInFordTown.Resources.innocents_song1.wav" />
    <None Remove="TroubleInFordTown.Resources.innocents_song2.wav" />
    <None Remove="TroubleInFordTown.Resources.jester_line1.wav" />
    <None Remove="TroubleInFordTown.Resources.jester_line2.wav" />
    <None Remove="TroubleInFordTown.Resources.jester_song1.wav" />
    <None Remove="TroubleInFordTown.Resources.jester_song2.wav" />
    <None Remove="TroubleInFordTown.Resources.lonewolf_song1.wav" />
    <None Remove="TroubleInFordTown.Resources.traitors_line1.wav" />
    <None Remove="TroubleInFordTown.Resources.traitors_line2.wav" />
    <None Remove="TroubleInFordTown.Resources.traitors_song1.wav" />
    <None Remove="TroubleInFordTown.Resources.traitors_song2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.brainwash_charge.wav" LogicalName="TroubleInFordTown.Resources.brainwash_charge.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.innocents_line1.wav" LogicalName="TroubleInFordTown.Resources.innocents_line1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.innocents_line2.wav" LogicalName="TroubleInFordTown.Resources.innocents_line2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.innocents_song1.wav" LogicalName="TroubleInFordTown.Resources.innocents_song1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.innocents_song2.wav" LogicalName="TroubleInFordTown.Resources.innocents_song2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.jester_line1.wav" LogicalName="TroubleInFordTown.Resources.jester_line1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.jester_line2.wav" LogicalName="TroubleInFordTown.Resources.jester_line2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.jester_song1.wav" LogicalName="TroubleInFordTown.Resources.jester_song1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.jester_song2.wav" LogicalName="TroubleInFordTown.Resources.jester_song2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.lonewolf_song1.wav" LogicalName="TroubleInFordTown.Resources.lonewolf_song1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.traitors_line1.wav" LogicalName="TroubleInFordTown.Resources.traitors_line1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.traitors_line2.wav" LogicalName="TroubleInFordTown.Resources.traitors_line2.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.traitors_song1.wav" LogicalName="TroubleInFordTown.Resources.traitors_song1.wav" />
    <EmbeddedResource Include="TroubleInFordTown.Resources.traitors_song2.wav" LogicalName="TroubleInFordTown.Resources.traitors_song2.wav" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(BONELAB_DIR)/MelonLoader/net6/MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSLZ.Marrow">
      <HintPath>$(BONELAB_DIR)/MelonLoader/Il2CppAssemblies/Il2CppSLZ.Marrow.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BONELAB_DIR)/MelonLoader/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BONELAB_DIR)/MelonLoader/Il2CppAssemblies/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BONELAB_DIR)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="LabFusion">
      <HintPath>$(BONELAB_DIR)/Mods/LabFusion.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(BONELAB_DIR)/MelonLoader/Il2CppAssemblies/UnityEngine.AudioModule.dll</HintPath>
